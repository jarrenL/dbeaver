                 class="org.jkiss.dbeaver.ext.gaussdb.debug.core.internal.GaussDBDebugAdapterFactory">
            <adapter type="org.jkiss.dbeaver.debug.DBGControllerFactory"/>
            <adapter type="org.jkiss.dbeaver.debug.DBGResolver"/>
        </factory>
        <factory adaptableType="org.jkiss.dbeaver.ext.gaussdb.model.GaussDBProcedure"
                 class="org.jkiss.dbeaver.ext.gaussdb.debug.core.internal.GaussDBBreakpointAdapterFactory">
            <adapter type="org.jkiss.dbeaver.debug.DBGBreakpointDescriptor"/>
        </factory>
    </extension>
</plugin>
